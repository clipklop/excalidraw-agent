# Copy this file to .dev.vars and fill in your keys
# cp .dev.vars.example .dev.vars

OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Any model identifier accepted by the configured API endpoint
OPENROUTER_MODEL=openai/gpt-5.4-mini

# Free signup at https://www.braintrust.dev — used in lesson 5 for the eval dashboard
BRAINTRUST_API_KEY=your-braintrust-api-key-here

# Free signup at https://tavily.com — 1000 searches/month free tier
# Used by the searchWeb tool added in lesson 7
TAVILY_API_KEY=your-tavily-api-key-here
